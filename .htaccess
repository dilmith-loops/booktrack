<IfModule mod_rewrite.c>
    RewriteEngine On
    DirectoryIndex index.html index.php

    # Prevent direct access to sensitive directories and files
    RewriteRule ^(\.git|\.env|storage|bootstrap/cache|vendor) - [F,L,NC]

    # Forward all web and API traffic into backend/public/
    RewriteRule ^$ backend/public/ [L,QSA]
    RewriteRule (.*) backend/public/$1 [L,QSA]
</IfModule>
