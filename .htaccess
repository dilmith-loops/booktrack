<IfModule mod_rewrite.c>
    RewriteEngine On
    DirectoryIndex index.html index.php

    # Prevent direct access to sensitive directories and files
    RewriteRule ^(\.git|\.env|backend/storage|backend/bootstrap/cache|backend/vendor) - [F,L,NC]

    # Don't rewrite if already pointing to backend/public
    RewriteCond %{REQUEST_URI} !^/backend/public/ [NC]
    RewriteRule ^$ backend/public/ [L,QSA]

    RewriteCond %{REQUEST_URI} !^/backend/public/ [NC]
    RewriteRule ^(.*)$ backend/public/$1 [L,QSA]
</IfModule>
