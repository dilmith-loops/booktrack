# MySQL 8 Server Configuration for AWS Lightsail (2 vCPUs, 4GB RAM)
# Target file: /etc/mysql/conf.d/lightsail-tuning.cnf

[mysqld]
# Basic Network & Connection Tuning
bind-address            = 127.0.0.1
max_connections         = 120
max_connect_errors      = 1000
connect_timeout         = 10
wait_timeout            = 600
interactive_timeout     = 600
thread_cache_size       = 32
open_files_limit        = 65535
table_open_cache        = 4000
table_definition_cache  = 2000

# Character Sets
character-set-server    = utf8mb4
collation-server        = utf8mb4_unicode_ci

# InnoDB Memory & Cache Tuning (Allocated: ~1.4GB RAM)
innodb_buffer_pool_size         = 1400M
innodb_buffer_pool_instances     = 2
innodb_log_buffer_size          = 16M
innodb_log_file_size            = 256M

# I/O Optimization for AWS Lightsail SSD
# 2 = Commit writes to OS cache; flushed to disk once per second (massive IOPS reduction)
innodb_flush_log_at_trx_commit  = 2
innodb_flush_method             = O_DIRECT
innodb_io_capacity              = 1000
innodb_io_capacity_max          = 2000
innodb_read_io_threads          = 4
innodb_write_io_threads         = 4
innodb_file_per_table           = 1

# Temporary Tables in RAM
tmp_table_size                  = 64M
max_heap_table_size             = 64M

# Logging
slow_query_log                  = 1
slow_query_log_file             = /var/log/mysql/slow.log
long_query_time                 = 2
